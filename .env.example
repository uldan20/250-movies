# Sinkronisasi antar perangkat memerlukan satu penyimpanan Redis.
#
# Cara termudah di Vercel: buka project -> Storage -> Create Database ->
# Upstash Redis (ada paket gratis) -> Connect. Vercel akan memasang variabel
# di bawah ini sendiri, jadi berkas ini hanya perlu disalin untuk pengembangan
# lokal (cp .env.example .env.local).
#
# Tanpa variabel ini aplikasi tetap berjalan normal; fitur sinkronisasi saja
# yang melaporkan bahwa penyimpanan bersama belum dipasang.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Nama dari integrasi Upstash langsung juga diterima:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
